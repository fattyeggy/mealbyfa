# 微信云托管环境变量示例（不要提交真实密钥）
MYSQL_URL=jdbc:mysql://<mysql-host>:3306/sancan_meal?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
MYSQL_USER=sancan
MYSQL_PASSWORD=<password>
JWT_SECRET=<32位以上随机串>
WX_APP_ID=<小程序AppID>
WX_APP_SECRET=<小程序AppSecret>
# 云托管若开启「开放接口服务」，访问 api.weixin.qq.com 会换成平台证书：
# 推荐在控制台关闭该服务；或把平台证书放进镜像并填路径。不要用下面的应急开关长期运行。
WX_CA_CERT_PATH=
WX_INSECURE_SKIP_TLS_VERIFY=false
MEAL_WX_MOCK_ENABLED=false
MEAL_ADMIN_DEMO_ACCOUNTS=false
ADMIN_USERNAME=<初始管理员>
ADMIN_PASSWORD=<强密码>
